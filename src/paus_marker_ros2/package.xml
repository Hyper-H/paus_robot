<?xml version="1.0"?>
<package format="3">
  <name>paus_marker_ros2</name>
  <version>0.1.0</version>
  <description>ROS2 coarse perception package for marker detection and target transform publishing.</description>
  <maintainer email="local@example.com">Local User</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <depend>paus_perception</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
